# ── Database (PostgreSQL) ───────────────────────────────────────────────
# Local: run `npm run db:local` and use the URLs below.
# Production (Supabase/Neon): DATABASE_URL = pooled URL, DIRECT_URL = direct URL (used for migrations).
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/dhm_business_os"
DIRECT_URL="postgresql://postgres:postgres@localhost:54329/dhm_business_os"

# ── Auth ────────────────────────────────────────────────────────────────
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# ── First admin account (used only by `npm run db:seed`) ────────────────
SEED_ADMIN_NAME="Owner"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# ── Scheduled jobs (reminders, recurring invoices) ──────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=""

# ── File storage ────────────────────────────────────────────────────────
# "db" (default) stores files inside PostgreSQL (max 4 MB/file on Vercel).
# "s3" uses any S3-compatible bucket (AWS S3, Cloudflare R2, Supabase Storage).
STORAGE_DRIVER="db"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── AI Business Assistant (optional) ────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# ── Public URL (used in shareable document links) ───────────────────────
APP_URL="http://localhost:3000"
